# =============================================================================
#  Meu INC App — variáveis de ambiente (modelo). Copie para `.env.local` e
#  preencha. NUNCA commite valores reais: `.env.local` está no .gitignore.
# =============================================================================
#
#  Nenhuma variável tem o prefixo NEXT_PUBLIC_ de propósito: a credencial do
#  banco fica só no servidor. O browser conversa com o banco pela rota interna
#  /api/data — ver docs/POSTGRES.md.
#
#  Sem PGHOST e sem DATABASE_URL, o app sobe em MODO DEMO: mostra os dados
#  estáticos de lib/data.ts e não grava nada.

# --- Forma preferida: variáveis separadas (evita escape de senha na URL) ---
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# --- Alternativa: connection string única ---
# Usada só quando PGHOST não está definido. O `sslmode` da URL é ignorado —
# quem decide o TLS é PGSSLMODE (ver abaixo).
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# --- TLS ---
#  require      (padrão) cifra a conexão sem validar o certificado — é o que
#               funciona com Postgres self-hosted / certificado autoassinado.
#  verify-ca    cifra e valida a cadeia do certificado.
#  verify-full  idem verify-ca.
#  disable      sem TLS.
PGSSLMODE=require

# --- Schema onde estão as tabelas ---
PGSCHEMA=meu_inc_app

# --- Opcional: tamanho do pool por instância (padrão 4) ---
# PGPOOL_MAX=4
